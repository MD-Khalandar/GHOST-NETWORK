# Local server configuration. These are names/placeholders only; do not
# commit provider credentials or production connection strings.
GHOST_ENV=development
GHOST_HOST=127.0.0.1
GHOST_PORT=3000
GHOST_DATABASE_URL=postgresql://localhost:5432/ghost
GHOST_MODEL_PROVIDER=fake
GHOST_MODEL=cp01-fake

# Required only when GHOST_MODEL_PROVIDER=openai. Keep the value out of Git.
# GHOST_OPENAI_API_KEY=

# Required in production. Role records store SHA-256 digests, not raw tokens.
# GHOST_AUTH_PRINCIPALS=[{"id":"gateway-c","role":"gateway","token_sha256":"<64 lowercase hex>","gateway_node_id":"<64 lowercase hex>"}]
# Server-only P-256 PEM, with literal \n escapes if needed. No fixture keys.
# GHOST_CLOUD_SIGNING_KEY_PEM=

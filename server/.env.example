GHOST_ENV=development
GHOST_HOST=127.0.0.1
GHOST_PORT=3000

# Optional for local health-only startup; required for uploads and production.
# Use an empty database owned by the GHOST service. Tables are created on startup.
# GHOST_DATABASE_URL=postgresql://ghost:<password>@127.0.0.1:5432/ghost

# Production: distinct role records with SHA-256 token digests, not raw tokens.
# GHOST_AUTH_PRINCIPALS=[{"id":"gateway-c","role":"gateway","token_sha256":"<64 lowercase hex>","gateway_node_id":"<64 lowercase hex>"}]
# For dashboard access add a separate viewer/operator record with its own token digest:
# {"id":"desk-viewer","role":"viewer","token_sha256":"<64 lowercase hex>"}
# Server-only P-256 PEM. Literal \n escapes are supported. Never use fixture keys.
# GHOST_CLOUD_SIGNING_KEY_PEM=

# Optional server-only AI matching. Provider defaults to openai.
# GHOST_AI_PROVIDER=openai
# OPENAI_API_KEY=
# For Gemini, set GHOST_AI_PROVIDER=gemini and use an AI Studio key:
# GEMINI_API_KEY=
# GHOST_COORDINATOR_MODEL=<model ID for the chosen provider>
